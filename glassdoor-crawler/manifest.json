{
  "manifest_version": 3,
  "name": "Glassdoor Company Crawler",
  "version": "1.3",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://*.glassdoor.com/*",
    "https://*.glassdoor.com.au/*",
    "https://*.glassdoor.co.uk/*",
    "https://*.glassdoor.de/*",
    "https://*.glassdoor.com.hk/*",
    "https://*.glassdoor.com.my/*",
    "https://*.glassdoor.sg/*",
    "https://*.glassdoor.ca/*",
    "https://*.glassdoor.co.in/*",
    "https://*.glassdoor.ie/*",
    "https://*.glassdoor.co.nz/*",
    "https://*.glassdoor.fr/*",
    "https://*.glassdoor.nl/*",
    "https://*.glassdoor.be/*",
    "https://*.glassdoor.at/*",
    "https://*.glassdoor.ch/*",
    "https://*.glassdoor.es/*",
    "https://*.glassdoor.it/*",
    "https://*.glassdoor.com.br/*",
    "https://*.glassdoor.com.mx/*",
    "https://*.glassdoor.com.ar/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Glassdoor Company Crawler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
