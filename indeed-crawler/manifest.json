{
  "manifest_version": 3,
  "name": "Indeed Company Crawler",
  "version": "1.5",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://sg.indeed.com/*",
    "https://au.indeed.com/*",
    "https://hk.indeed.com/*",
    "https://uk.indeed.com/*",
    "https://my.indeed.com/*",
    "https://de.indeed.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Indeed Company Crawler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
